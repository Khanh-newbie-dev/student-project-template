# Quy chuẩn Code chung cho nhóm
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,java,py,js,ts}]
# Quy tắc dòng trống và độ rộng
max_line_length = 120

[*.cs]
# Quy tắc C# / .NET
csharp_new_line_before_open_brace = all
csharp_style_var_for_built_in_types = true
